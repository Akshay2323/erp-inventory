{
  "name": "inventory-app",
  "version": "1.0.0",
  "description": "inventory-app API with Swagger and MySQL",
  "main": "src/server.js",
  "scripts": {
    "build": "npm run init-db",
    "export-build": "npm run build && node scripts/exportBuild.js",
    "setup": "npm install && npm run build",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-db": "node src/config/initDb.js",
    "migrate-db": "node src/config/initDb.js",
    "reset-db": "node src/config/resetDb.js"
  },
  "keywords": [
    "inventory",
    "api",
    "swagger",
    "mysql"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
