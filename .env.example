PORT=4000
# Comma-separated frontend origins allowed by CORS (empty = allow any origin)
CORS_ORIGINS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inventory_db

SHARED_DB_HOST=127.0.0.1
SHARED_DB_PORT=3306
SHARED_DB_USER=root
SHARED_DB_PASSWORD=your_mysql_password
SHARED_DB_NAME=hrms_db

# Company "Auto Fetch from HRMS" — set false if this install has no HRMS
HRMS_ENABLED=true
# HRMS web URL, used to build logo URLs (<url>/storage/<logo path>)
HRMS_PUBLIC_URL=

# Branch map "Search Location (India)" — OpenStreetMap Nominatim by default (set a contact in the user agent)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=inventory-app/1.0 (admin@example.com)

JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRES=7d
ENCRYPTION_KEY=change-this-32-character-key!!
